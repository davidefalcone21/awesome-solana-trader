# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Encryption Key (Fernet key for encrypting user private keys)
# Generate a new key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API Configuration
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap

# Birdeye API Key (Optional - for backward compatibility)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Solana Tracker API Key (Required for portfolio balances)
SOLANA_TRACKER_API_KEY=your_solana_tracker_api_key_here

# Platform Fee Configuration
PLATFORM_FEE_WALLET=your_platform_fee_wallet_address_here
PLATFORM_FEE_BPS=100